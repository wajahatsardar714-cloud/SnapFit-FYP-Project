# Relative + proxied by Vite (see vite.config.js) so the dev server works both on
# localhost and over the LAN from a phone (needed for the QR mobile-capture
# handoff, and to avoid mixed-content issues once the dev server is HTTPS).
# In production, point this at the real backend's absolute URL instead.
VITE_API_URL=/api

# Optional, local only: pre-fills the /demo/size-check page's API key.
# VITE_DEMO_API_KEY=sk_live_...
# VITE_DEMO_PRODUCT_IMAGE=/uploads/products/<file>.png
# VITE_DEMO_PRODUCT_NAME=White Crew Neck T-Shirt
