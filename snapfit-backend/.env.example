PORT=5000
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.9d8p8uu.mongodb.net/snapfit?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_string
AI_SERVICE_URL=http://localhost:8000
# Super admin account, created/updated on server start (password: 8+ characters)
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=replace_with_a_strong_password

# Admin demo studio: the demo store (a merchant id) and its mapped product.
DEMO_MERCHANT_ID=
DEMO_PRODUCT_ID=demo-product-1

# Push notifications (Firebase Cloud Messaging). Path to a Firebase service-account
# JSON file, or the JSON itself on one line. Leave empty to turn push off; in-app
# notifications work either way.
FIREBASE_SERVICE_ACCOUNT=

# Seller details printed on subscription receipts (all optional).
RECEIPT_ADDRESS=
RECEIPT_EMAIL=
RECEIPT_WEBSITE=

# Where merchant product images are stored: local (default; uploads/products on
# this server) or r2 (Cloudflare R2 bucket). With r2 every R2_* below is required.
STORAGE_DRIVER=local
# Cloudflare account ID (R2 > Overview); the S3 endpoint is https://<id>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=your_cloudflare_account_id
# R2 API token with Object Read & Write on the bucket (R2 > Manage API tokens)
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# Bucket that holds the images (keys: merchants/<merchantId>/products/<productId>/...)
R2_BUCKET=snapfit-product-images
# Public base URL of the bucket (r2.dev subdomain or a custom domain), no trailing slash
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev
